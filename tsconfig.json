{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@corpix/shared": ["packages/shared/src/index.ts"],
      "@corpix/agents": ["packages/agents/src/index.ts"],
      "@corpix/server/db": ["apps/server/src/db/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "apps/cli/**/*.ts", "apps/server/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
