# These values seed the database on first boot. After that, edit everything
# from the web UI (Settings tab) or `pnpm cli settings`.
#
# By default environment variables do NOT override stored settings, so copying
# this file does not lock the UI. To force values from the environment (CI,
# containers), list them in CORPIX_PIN, e.g.:
#   CORPIX_PIN=LLM_PROVIDER,LLM_BASE_URL,LLM_API_KEY,BOSS_MODEL
# or CORPIX_PIN=* to pin every variable that is set.
CORPIX_PIN=

# --- Provider ---------------------------------------------------------------
LLM_PROVIDER=openai-compatible      # openai-compatible | mock
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MAX_TOKENS_PARAM=max_tokens

# --- Models (can be overridden per role in config/roles/*.yaml) -------------
BOSS_MODEL=your-strongest-model-id
WORKER_MODEL=your-balanced-model-id
CHEAP_MODEL=your-cheap-model-id

# --- Limits -----------------------------------------------------------------
MAX_CONCURRENT_AGENTS=3
MAX_STEPS_PER_TASK=40
# Each agent has its own context budget; this is the default per agent.
CONTEXT_TOKENS_PER_AGENT=120000
TASK_TIMEOUT_MINUTES=20
TOOL_OUTPUT_MAX_CHARS=8000
BUDGET_USD_PER_GOAL=5
BUDGET_ACTION=pause                 # pause | stop

# --- Safety -----------------------------------------------------------------
APPROVAL_MODE=ask                   # ask | auto-safe | auto
SANDBOX=none                        # none | docker
SANDBOX_IMAGE=node:22-bookworm-slim
HOST=127.0.0.1
PORT=3001
ADMIN_TOKEN=

# --- Paths and logging ------------------------------------------------------
DATA_DIR=./data
WORKSPACES_DIR=./workspaces
LOG_LEVEL=info
