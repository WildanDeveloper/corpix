{
  "name": "corpix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run your own AI software company.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "pnpm --filter @corpix/web dev",
    "dev": "pnpm -r --parallel --filter @corpix/server --filter @corpix/web dev",
    "dev:demo": "LLM_PROVIDER=mock pnpm dev",
    "cli": "tsx apps/cli/src/index.ts",
    "db:migrate": "tsx apps/cli/src/migrate.ts",
    "build": "node scripts/build.mjs && pnpm --filter @corpix/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'eslint config lands with the web app (Phase 1)' && exit 0",
    "start": "node dist/server.mjs",
    "cli:prod": "node dist/cli.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "esbuild": "^0.25.0"
  },
  "bin": {
    "corpix": "dist/cli.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0"
  }
}